# download licenses of dependencies

set -e

# put licenses here
LICENSES="@CMAKE_BINARY_DIR@/licenses"
mkdir -p "${LICENSES}"

# sqlite3-pcre is public domain
# download pcre2 license
pcre2="${LICENSES}/pcre2-LICENSE.md"
if [[ ! -f "${pcre2}" ]]; then
    wget https://raw.githubusercontent.com/PCRE2Project/pcre2/refs/heads/main/LICENCE.md -O "${pcre2}"
fi

# sqlite-vec licenses
vec_apache="${LICENSES}/sqlite-vec-LICENSE-APACHE"
if [[ ! -f "${vec_apache}" ]]; then
    wget https://raw.githubusercontent.com/asg017/sqlite-vec/refs/heads/main/LICENSE-APACHE -O "${vec_apache}"
fi

vec_mit="${LICENSES}/sqlite-vec-LICENSE-MIT"
if [[ ! -f "${vec_mit}" ]]; then
    wget https://raw.githubusercontent.com/asg017/sqlite-vec/refs/heads/main/LICENSE-MIT -O "${vec_mit}"
fi

# sqlite-lembed licenses
lembed="${LICENSES}/sqlite-lembed"
if [[ ! -f "${lembed}" ]]; then
    (
        echo "sqlite-lembed does not have a license file in the repository."
        echo "However, the sqlite-dist.toml file (https://github.com/asg017/sqlite-lembed/blob/main/sqlite-dist.toml) lists the licenses as MIT OR Apache."
        echo "See the license for sqlite-vec, as they are the same licenses from the same author."
    ) > "${lembed}"
fi

llama_cpp="${LICENSES}/llama.cpp-LICENSE"
if [[ ! -f "${llama_cpp}" ]]; then
    wget https://raw.githubusercontent.com/ggml-org/llama.cpp/refs/heads/master/LICENSE -O "${llama_cpp}"
fi

openmp="${LICENSES}/openmp-LICENSE.TXT"
if [[ ! -f "${openmp}" ]]; then
    wget https://raw.githubusercontent.com/llvm/llvm-project/refs/heads/main/openmp/LICENSE.TXT -O "${openmp}"
fi

jemalloc="${LICENSES}/jemalloc-COPYING"
if [[ ! -f "${jemalloc}" ]]; then
    wget https://raw.githubusercontent.com/jemalloc/jemalloc/refs/heads/dev/COPYING -O "${jemalloc}"
fi
