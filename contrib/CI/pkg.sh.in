set -e

# This script is intended to be run on a clean macOS
# environment such as the GitHub Actions runner. This
# script will overwrite existing configuration files.

# need SQLite3 CLI
export PATH="@DEP_INSTALL_PREFIX@/sqlite3/bin:${PATH}"

arch="$(uname --machine)"

# make the PKGs
# doing in 2 steps because productbuild likes to
# merge all components into a monolithic PKG

# make the primary PKG
# requires root to stage @CONFIG@ for copying into PKG
sudo cpack -G productbuild -DCPACK_COMPONENTS_ALL=Local -B "@CMAKE_BINARY_DIR@"
pkg="GUFI-@CMAKE_PROJECT_VERSION@-Darwin.pkg"
local="gufi-@CMAKE_PROJECT_VERSION@.macOS.${arch}.pkg"
sudo rm -rf @CPACK_PACKAGING_INSTALL_PREFIX@/etc/GUFI # this assumes GUFI wasn't previously installed
sudo chown "${USER}" "${pkg}"
mv "${pkg}" "${local}"

# make the remote PKG
# requires root to stage @REMOTE_CONFIG@ for copying into PKG
sudo cpack -G productbuild -DCPACK_COMPONENTS_ALL=Remote -B "@CMAKE_BINARY_DIR@"
pkg="GUFI-@CMAKE_PROJECT_VERSION@-Darwin.pkg"
remote="gufi-remote-@CMAKE_PROJECT_VERSION@.macOS.${arch}.pkg"
sudo rm -rf @CPACK_PACKAGING_INSTALL_PREFIX@/etc/GUFI
sudo chown "${USER}" "${pkg}"
mv "${pkg}" "${remote}"

# list the files
pkgutil --payload-files "${local}" | sort
pkgutil --payload-files "${remote}" | sort

# install the primary PKG
sudo installer -verbose -pkg "${local}" -target /

# set up environment
INSTALL_PREFIX="@CPACK_PACKAGING_INSTALL_PREFIX@"
export PATH="${INSTALL_PREFIX}/bin:${PATH}"
export DYLD_LIBRARY_PATH="${INSTALL_PREFIX}/lib:${DYLD_LIBRARY_PATH}"
export PYTHONPATH="${INSTALL_PREFIX}/lib:${PYTHONPATH}"

# GitHub macOS runner does not run as root, so test_install.sh would fail on copy
sudo cp "$(dirname @CONFIG@)/config.example" "@CONFIG@"

"@CMAKE_BINARY_DIR@/contrib/test_install.sh" "${INSTALL_PREFIX}" "@CONFIG@" 2>&1
