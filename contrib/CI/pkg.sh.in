set -e

# The SQLite 3 CLI does not need to be available
# for normal GUFI usage, so it is not installed
# by the dependency installer. GUFI uses a
# custom built SQLite 3 and the CLI of this build
# is not necessarily visible to users, so
# installing a system SQLite 3 here to test gufi_vt.
brew install -y sqlite3
# shellcheck disable=SC2155
export PATH="$(brew --prefix sqlite3)/bin:${PATH}"

arch="$(uname --machine)"

# make the PKGs
# doing in 2 steps because productbuild likes to
# merge all components into a monolithic PKG

# make the server PKG
# requires root to stage @SERVER_CONFIG@ for copying into PKG
sudo cpack -G productbuild -DCPACK_COMPONENTS_ALL=Server -B "@CMAKE_BINARY_DIR@"
pkg="GUFI-@CMAKE_PROJECT_VERSION@-Darwin.pkg"
server=$(echo "${pkg}" | sed "s%GUFI%gufi-server%g; s%-Darwin-Server%.macOS.${arch}%g;")
sudo mv "${pkg}" "${server}"
sudo chown "${USER}" "${server}"

# make the client PKG
# requires root to stage @CLIENT_CONFIG@ for copying into PKG
sudo cpack -G productbuild -DCPACK_COMPONENTS_ALL=Client -B "@CMAKE_BINARY_DIR@"
pkg="GUFI-@CMAKE_PROJECT_VERSION@-Darwin.pkg"
client=$(echo "${pkg}" | sed "s%GUFI%gufi-client%g; s%-Darwin-Client%.macOS.${arch}%g;")
sudo mv "${pkg}" "${client}"
sudo chown "${USER}" "${client}"

# list the files
pkgutil --payload-files "${server}" | sort
pkgutil --payload-files "${client}" | sort

# install the server
sudo installer -verbose -pkg "${server}" -target /

# set up environment
INSTALL_PREFIX="/Applications"
export PATH="${INSTALL_PREFIX}/bin:${PATH}"
export DYLD_LIBRARY_PATH="${INSTALL_PREFIX}/lib:${DYLD_LIBRARY_PATH}"
export PYTHONPATH="${INSTALL_PREFIX}/lib:${PYTHONPATH}"

# /etc/GUFI would have been created by the installer
CONFIG="/etc/GUFI/config"

COPIED=0
if [[ ! -f "${CONFIG}" ]]
then
    # GitHub macOS runner does not run as root, so test_install.sh would fail on copy
    sudo cp "/etc/GUFI/server.example" "${CONFIG}"
    COPIED=1
fi

"@CMAKE_BINARY_DIR@/contrib/test_install.sh" "${INSTALL_PREFIX}" "${CONFIG}" 2>&1

if [[ "${COPIED}" -eq 1 ]]
then
    sudo rm "${CONFIG}"
fi
