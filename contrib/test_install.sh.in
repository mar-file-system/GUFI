# Basic tests to see if a GUFI install works
#
# Environment variables should be set up before calling this script
#     PATH
#     [DY]LD_LIBRARY_PATH
#     PYTHONPATH
#
# A SQLite 3 install from GUFI or the system may be used
#
# NOTE: This file creates a config file if one is not found.
#       The paths may not be correct, so double check the file.
#

set -e

INSTALL_PREFIX="$1"
SERVER_CONFIG="${2:-/etc/GUFI/config}"

SERVER_CONFIG_DIR=$(dirname "${SERVER_CONFIG}")
SERVER_CONFIG_EXAMPLE="${SERVER_CONFIG_DIR}/server.example"

set -x

tail -n 23 "${SERVER_CONFIG_EXAMPLE}"

# the C binaries run
gufi_query --help
gufi_sqlite3 --help

# the extensions load
echo ".load ${INSTALL_PREFIX}/lib/gufi_vt" | sqlite3
echo ".load ${INSTALL_PREFIX}/lib/run_vt"  | sqlite3

# the Python3 library files can be imported
python3 -c "import gufi_common, gufi_config"

# the user facing scripts work
if [[ ! -f "${SERVER_CONFIG}" ]]
then
    cp "${SERVER_CONFIG_EXAMPLE}" "${SERVER_CONFIG}"
fi
gufi_find --help
