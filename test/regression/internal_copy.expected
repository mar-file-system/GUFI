# run on original tree - no internal tables found so no results
$ gufi_query -d "|" -I "CREATE TABLE copied(i int, j TEXT);" --internal-copy "SELECT name FROM tree.sqlite_master WHERE name == 'internal';" "INSERT INTO copied SELECT i, j FROM tree.internal;" -S "SELECT rpath(sname, sroll), i, j FROM vrsummary JOIN copied ON vrsummary.inode == copied.j; DELETE FROM copied;" "prefix"

# set up one db.db with a nonstandard internal table

# only one directory has internal data to join with
$ gufi_query -d "|" -I "CREATE TABLE copied(i int, j TEXT);" --internal-copy "SELECT name FROM tree.sqlite_master WHERE name == 'internal';" "INSERT INTO copied SELECT i, j FROM tree.internal;" -S "SELECT rpath(sname, sroll), i, j FROM vrsummary JOIN copied ON vrsummary.inode == copied.j; DELETE FROM copied;" "prefix"
