#####################################
# Bad Inputs                        #
#####################################
# bad prefix
$ gufi_query --no-print-sql-on-err --max-level 0 -I "ATTACH 'file:fsid.db?mode=ro' AS fsid_config; ATTACH 'file:extdbprefix.db?mode=ro' AS extdbprefix;" -E "SELECT create_spread('extdbprefix.db', 'bad-prefix-file', 'fsid', rpath(sname, sroll, name), inode, mtime) FROM vrpentries WHERE type == 'f';" "prefix"
Error: Failed to locate shard path generator
Error: Did not get result from gufi_spread_copy_to_shard.sh: prefix/db.db

# try to copy non-existent shard
$ gufi_query --no-print-sql-on-err --max-level 0 -I "ATTACH 'file:extdbprefix.db?mode=ro' AS extdbprefix;" -E "SELECT spread_to_external('prefix-file', 'fsid', rpath(sname, sroll, name), inode, mode, uid, gid, mtime, dmode, duid, dgid) FROM vrpentries WHERE type == 'f';" "prefix"
Runtime error near line 1: unable to open database: file:spread_tree/prefix-file/fsid/10/00/00.db?mode=ro (14)
Parse error near line 65: no such table: shard.extracted
Error: sqlite3 errored: prefix/db.db

# missing extdbprefix.db
$ gufi_query --no-print-sql-on-err --max-level 0 -E "SELECT spread_to_external('prefix-file', 'fsid', rpath(sname, sroll, name), inode, mode, uid, gid, mtime, dmode, duid, dgid) FROM vrpentries WHERE type == 'f';" "prefix"
Error: Could not data from extdb: no such table: extdb: prefix/db.db

# bad mode
$ gufi_query --no-print-sql-on-err --max-level 0 -I "ATTACH 'file:extdbprefix.db?mode=ro' AS extdbprefix;" -E "SELECT spread_to_external('prefix-file', 'fsid', rpath(sname, sroll, name), inode, 'bad_mode', uid, gid, mtime, dmode, duid, dgid) FROM vrpentries WHERE type == 'f';" "prefix"
Error: Bad mode: bad_mode: prefix/db.db

# NULL mode
$ gufi_query --no-print-sql-on-err --max-level 0 -I "ATTACH 'file:extdbprefix.db?mode=ro' AS extdbprefix;" -E "SELECT spread_to_external('prefix-file', 'fsid', rpath(sname, sroll, name), inode, NULL, uid, gid, mtime, dmode, duid, dgid) FROM vrpentries WHERE type == 'f';" "prefix"
Error: Missing mode: prefix/db.db

