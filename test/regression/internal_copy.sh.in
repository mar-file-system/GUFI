set -e
. @CMAKE_CURRENT_BINARY_DIR@/setup.sh 1

OUTPUT="internal_copy.out"

(
    # per-thread table where copied data is placed
    I="CREATE TABLE copied(i int, j TEXT);"

    # name of the internal table
    TABLE="internal"

    # SQL for testing if COPY_SQL should be run
    TEST_SQL="SELECT name FROM tree.sqlite_master WHERE name == '${TABLE}';"

    # SQL for inserting into table created by -I
    COPY_SQL="INSERT INTO copied SELECT i, j FROM tree.${TABLE};"

    echo "# run on original tree - no internal tables found so no results"
    run_no_sort "${GUFI_QUERY} -d \"${DELIM}\" -I \"${I}\" --internal-copy \"${TEST_SQL}\" \"${COPY_SQL}\" -S \"SELECT rpath(sname, sroll), i, j FROM vrsummary JOIN copied ON vrsummary.inode == copied.j; DELETE FROM copied;\" \"${INDEXROOT}\""

    echo "# set up one db.db with a nonstandard internal table"
    (
        echo "CREATE TABLE ${TABLE} (j TEXT, i INT);"
        echo "INSERT INTO ${TABLE} VALUES ('7', 1234);"
    ) | "${SQLITE3}" "${INDEXROOT}/directory/db.db"
    echo

    echo "# only one directory has internal data to join with"
    run_no_sort "${GUFI_QUERY} -d \"${DELIM}\" -I \"${I}\" --internal-copy \"${TEST_SQL}\" \"${COPY_SQL}\" -S \"SELECT rpath(sname, sroll), i, j FROM vrsummary JOIN copied ON vrsummary.inode == copied.j; DELETE FROM copied;\" \"${INDEXROOT}\""
) | replace | tee "${OUTPUT}"

@DIFF@ @CMAKE_CURRENT_BINARY_DIR@/internal_copy.expected "${OUTPUT}"
rm "${OUTPUT}"
