# Compare index states

#####################################

#####################################
# existing parking lot
$ find -name "parking_lot" 2>/dev/null

$ mkdir "parking_lot"

$ gufi_incremental_update -n 2 --process-subtrees --suspect-method 3 "prefix" "prefix" "parking_lot" > /dev/null 2>&1

$ find -name "parking_lot" 2>/dev/null
./parking_lot

#####################################

#####################################
# keep artifacts
# artifacts directory exists
$ mkdir "<artifacts_dir>"

$ gufi_incremental_update -n 2 --process-subtrees --suspect-time 0 --suspect-method 3 --keep-artifacts "<artifacts_dir>" "prefix" "prefix" "parking_lot" > /dev/null

$ find "<artifacts_dir>" -type f
<artifacts_dir>/<inode>.created
<artifacts_dir>/<inode>.diff
<artifacts_dir>/<inode>.index
<artifacts_dir>/<inode>.tree
<artifacts_dir>/<inode>.urd

# artifacts directory exists and only has rx permission (good)
$ chmod 333 "<artifacts_dir>"

$ gufi_incremental_update -n 2 --process-subtrees --suspect-time 0 --suspect-method 3 --keep-artifacts "<artifacts_dir>" "prefix" "prefix" "parking_lot" > /dev/null

# artifacts directory does not exist
$ rm -rf "<artifacts_dir>"

$ gufi_incremental_update -n 2 --process-subtrees --suspect-time 0 --suspect-method 3 --keep-artifacts "<artifacts_dir>" "prefix" "prefix" "parking_lot" > /dev/null
Error: Could not get realpath of "<artifacts_dir>": No such file or directory (2)

# artifacts directory is the parking lot created by gufi_incremental_update
$ gufi_incremental_update -n 2 --process-subtrees --suspect-time 0 --suspect-method 3 --keep-artifacts "parking_lot" "prefix" "prefix" "parking_lot" > /dev/null
Error: Refusing to save artifacts to the parking lot directory "parking_lot" because it will be deleted at the end

# artifacts directory is an existing parking lot
$ gufi_incremental_update -n 2 --process-subtrees --suspect-time 0 --suspect-method 3 --keep-artifacts "parking_lot" "prefix" "prefix" "parking_lot" > /dev/null

#####################################

#####################################
# Invalid Inputs                    #
#####################################
# non-existent index
$ gufi_incremental_update -x --suspect-method 3 "baddir/prefix" "prefix" "parking_lot" > /dev/null
Error: Could not get realpath of "baddir/prefix": No such file or directory (2)

# non-existent tree
$ gufi_incremental_update -x --suspect-method 3 "prefix" "baddir/prefix" "parking_lot" > /dev/null
Error: Could not get realpath of "baddir/prefix": No such file or directory (2)

# non-existent parking lot
$ gufi_incremental_update -x --suspect-method 3 "prefix" "prefix" "baddir/parking_lot" > /dev/null
Error: Could not create parking lot directory "baddir/parking_lot": No such file or directory (2)

# file index
$ gufi_incremental_update -x --suspect-method 3 "gufi_incremental_update" "prefix" "parking_lot" > /dev/null
Error: index path is not a directory "gufi_incremental_update"

# file tree
$ gufi_incremental_update -x --suspect-method 3 "prefix" "gufi_incremental_update" "parking_lot" > /dev/null
Error: tree path is not a directory "gufi_incremental_update"

# file parking lot
$ gufi_incremental_update -x --suspect-method 3 "prefix" "prefix" "gufi_incremental_update" > /dev/null
Error: Existing parking lot path "gufi_incremental_update" is not a directory

# bad suspect file
$ gufi_incremental_update -x --suspect-method 3 --suspect-file "baddir/suspectfile" "prefix" "prefix" "parking_lot" > /dev/null
Can't open suspect file baddir/suspectfile

# bad max subtrees prefix
$ gufi_incremental_update -x --suspect-method 3 --max-subtrees 0 "prefix" "prefix" "parking_lot" > /dev/null
argument '--max-subtrees' not in range [1, 18446744073709551615]

# bad thread count
$ gufi_incremental_update -x --suspect-method 3 -n 18446744073709551615 "prefix" "prefix" "parking_lot" > /dev/null
Error: Failed to start thread pool

