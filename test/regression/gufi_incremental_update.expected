$ gufi_incremental_update --help
usage: gufi_incremental_update [options] GUFI_tree dir parking_lot
options:
  -h, --help                        help
  -H, --debug                       show assigned input values (debugging)
  -v, --version                     version
  -n, --threads <n>                 number of threads
      --suspect-stat                if an entry is suspect, stat it to get timestamps to compare against suspecttime
      --suspect-file <path>         suspect input file
      --suspect-method <0|1|3>      suspect method (0 no suspects, 1 suspect file_dfl, 3 suspect stat_dfl)
      --suspect-time <s>            time in seconds since epoch for suspect comparision
      --max-subtrees <count>        maximum number of subtrees to process in parallel (control maximum number of file descriptors used)
      --keep-artifacts <path>       place artifacts here so they are not automatically deleted (provided path must already exist)
      --process-subtrees            try to find and operate on subtrees instead of operating on the entire tree at once
  -x, --index-xattrs                index xattrs
      --plugin <entrypoint>:<path>  plugin library for modifying tree processing
      --compress                    compress work items

GUFI_tree         GUFI tree
dir               source tree
parking_lot       directory prefix to place update db.dbs and moved directories

GUFI_tree and tree may be the same path


#####################################
# suspect method 0
# create source tree
$ find "prefix"
prefix
prefix/change
prefix/delete
prefix/no-change
prefix/rename

# get index original version of source tree
$ gufi_dir2index prefix search
Creating GUFI tree search with 1 threads
Total Dirs:          5
Total Non-Dirs:      0

# modify source tree
$ find "prefix"
prefix
prefix/change
prefix/change/new_file
prefix/created
prefix/no-change
prefix/renamed

# run gufi_dir2index on the updated tree to serve as the expected results
$ gufi_dir2index prefix updated-index
Creating GUFI tree updated-index with 1 threads
Total Dirs:          5
Total Non-Dirs:      1

# Update the original index via incremental update
$ gufi_incremental_update -n 2 -x  --suspect-method 0 "prefix" "prefix" "parking_lot" > /dev/null

# State of updated index created with gufi_dir2index
prefix/change/new_file|33204|uid|gid
prefix/change|16893|uid|gid
prefix/created|16893|uid|gid
prefix/no-change|16893|uid|gid
prefix/renamed|16893|uid|gid
prefix|16893|uid|gid

# State of incrementally updated index
prefix/change|16893|uid|gid
prefix/no-change|16893|uid|gid
prefix/renamed|16893|uid|gid
prefix|16893|uid|gid

# Compare index states
1d0
< prefix/change/new_file|33204|uid|gid
3d1
< prefix/created|16893|uid|gid
# differences showed up because the directories were not marked as suspect and were not reindexed
# when the update dbs were being applied, the directories that needed new db.dbs did not have them
