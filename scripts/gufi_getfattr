import argparse
import os
import sys

from gufi_common import SQLITE3_TEXT
import gufi_common
import gufi_config

PATH = os.path.realpath(__file__)

def getfattr(args, indexroot, dirname, nondirname):
    # pylint: disable=invalid-name,too-many-branches

    indexroot_len = len(indexroot) + 2

    S_cols = []
    E_cols = []
    if args.only_values:
        # --only-values overrides selections
        S_cols = ['xattr_value']
        E_cols = ['xattr_value']
    else:
        # default to getting path and xattr name
        S_cols = ['substr(rpath(sname, sroll), {0})'.format(indexroot_len),
                  'xattr_name']
        E_cols = ['substr(rpath(sname, sroll, name), {0})'.format(indexroot_len),
                  'xattr_name']

        # also get xattr value
        if args.dump:
            S_cols += ['xattr_value']
            E_cols += ['xattr_value']

    S_where = []
    E_where = []

    if not args.recursive:
        # make sure name matches
        S_where += [' OR '.join(['(name REGEXP \'^{0}$\')'.format(os.path.basename(dirname))])]

        # only get the original summary
        S_where += ['isroot == 1']

        if nondirname:
            E_where += [' OR '.join(['(name REGEXP \'^{0}$\')'.format(nondirname)])]

    if args.name:
        # name uses exact match
        S_where += ['CAST(xattr_name AS {1}) == CAST(\'{0}\' AS {1})'.format(args.name, SQLITE3_TEXT)]
        E_where += ['CAST(xattr_name AS {1}) == CAST(\'{0}\' AS {1})'.format(args.name, SQLITE3_TEXT)]
    else:
        S_where += ['xattr_name REGEXP \'{0}\''.format(args.pattern)]
        E_where += ['xattr_name REGEXP \'{0}\''.format(args.pattern)]

    query_args = [
        '-x',
        '-a', '1',
    ]

    if args.recursive:
        # if input directory is not a directory, filter xattrs to those in the current directory
        if nondirname:
            E_where += ['atroot == 1']

        # if input path is a directory, get directory xattrs as well
        else:
            query_args += ['-S', gufi_common.build_query(S_cols,
                                                         [gufi_common.VRXSUMMARY],
                                                         S_where,
                                                         None,
                                                         None,
                                                         None)]

        # if input path is not a directory, get non directory xattrs
        # if input path is     a directory, get non directory xattrs
        query_args += ['-E', gufi_common.build_query(E_cols,
                                                     [gufi_common.VRXPENTRIES],
                                                     E_where,
                                                     None,
                                                     None,
                                                     None)]

    else:
        # only get non directory xattrs
        if nondirname:
            E_where += ['atroot == 1']

            query_args += ['-E', gufi_common.build_query(E_cols,
                                                         [gufi_common.VRXPENTRIES],
                                                         E_where,
                                                         None,
                                                         None,
                                                         None)]
            # only get directory xattrs
        else:
            query_args += ['-S', gufi_common.build_query(S_cols,
                                                         [gufi_common.VRXSUMMARY],
                                                         S_where,
                                                         None,
                                                         None,
                                                         None)]

    # a non directory prevents recursion
    if nondirname:
        query_args += ['--min-level', '0',
                       '--max-level', '0']

    return query_args + [dirname]

def parse_args(argv):
    parser = argparse.ArgumentParser(
        'gufi_getfattr',
        description='GUFI version of getfattr\n\nNote: -h/--no-dereference and -P/--physical are always set',
        add_help=False, formatter_class=argparse.RawDescriptionHelpFormatter)

    gufi_common.add_help_version(parser)

    parser.add_argument('-n', '--name',
                        type=str,
                        help='Dump the values of the named extended attribute')
    parser.add_argument('-d', '--dump',
                        action='store_true',
                        help='Dump the values of all extended attributes associated with pathname')
    parser.add_argument('-m', '--match',
                        dest='pattern',
                        type=str,
                        help='Only include attributes with names matching the regular expression pattern. The default value for pattern is "^user\\.", which includes all the attributes in the user namespace. Specify "-" for including all attributes. Refer to attr(5) for a more detailed discussion of namespaces.',
                        default='^user\\.')
    parser.add_argument('--only-values',
                        action='store_true',
                        help='Dump out the raw extended attribute value(s) without encoding them')
    parser.add_argument('-R', '--recursive',
                        action='store_true',
                        help='List the atttributes of all files and directories recursively')

    parser.add_argument('path',
                        type=str,
                        nargs='+')

    gufi_common.add_common_flags(parser)

    return parser.parse_args(argv[1:])

def gen_cmd(config, args, path):
    '''
    path should be a single string
    '''

    path, basename = gufi_common.split_path(path, config.indexroot)

    if path is None:
        return None

    # create the query command
    query_cmd = [
        config.query,
        '--no-print-sql-on-err',
        '--threads', str(config.threads),
        '--output-buffer-size', str(config.outputbuffer),
        '--delim', args.delim
    ] + getfattr(args, config.indexroot, path, basename)

    return query_cmd

def gen_cmds(config, args):
    '''
    generate gufi_getfattr cmds

    loops on each path no matter what the path type is
    (not strictly necessary - generated SQL does an
    explicit check on the name in the summary table)
    '''

    if args.pattern == '-':
        args.pattern = '.*'

    cleaned = gufi_common.clean_paths(args.path, config.indexroot)

    # does not call gufi_common.gen_cmds
    return [cmd for cmd in [gen_cmd(config, args, path) for path in cleaned] if cmd is not None]

def run(argv, config_path, stdout=None, stderr=None):
    config = gufi_config.Server(config_path)
    args = parse_args(argv)
    cmds = gen_cmds(config, args)
    return gufi_common.run_cmds(args, cmds,
                                1, 1, stdout, stderr)

if __name__ == '__main__':
    sys.exit(run(sys.argv, gufi_config.PATH)[0])
