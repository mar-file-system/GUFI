import argparse
import sys

import gufi_common
import gufi_config

def parse_args(argv):
    # parse the arguments
    parser = argparse.ArgumentParser('gufi_stat', description='GUFI version of stat', add_help=False)

    gufi_common.add_help_version(parser)

    # parser.add_argument('-L', '--dereference'
    #                     action='set_true',
    #                     help='follow links')

    # parser.add_argument('-f', '--file-system'
    #                     action='set_true',
    #                     help='display file system status instead of file status')

    parser.add_argument('-c', '--format',
                        metavar='FORMAT',
                        type=str,
                        help='use the specified FORMAT instead of the default; output a newline after each use of FORMAT')

    # parser.add_argument('--printf',
    #                     metavar='FORMAT',
    #                     type=str,
    #                     help='like --format but interpret backslash escapes, and do not output a mandatory trailing newline; if you want a newline, include \n in FORMAT')

    parser.add_argument('-t', '--terse',
                        action='store_true',
                        help='print the information in terse form')

    parser.add_argument('paths',
                        metavar='FILE',
                        nargs='+')

    # does not call gufi_query, so need custom verbose flag
    parser.add_argument('-V', '--verbose',
                        action='store_true',
                        help='Show the actual command being run')

    return parser.parse_args(argv[1:])

def gen_cmd(config, args, paths):
    # no need to split path
    # gufi_stat_bin does it

    # create the stat command
    stat_cmd = [config.stat]

    if args.format is not None:
        stat_cmd += ['--format', args.format]

    if args.terse is True:
        stat_cmd += ['--terse']

    return stat_cmd + paths

def gen_cmds(config, args):
    '''
    only returns 0 or 1 commands to run
    gufi_stat_bin handles the paths
    '''

    cleaned = gufi_common.clean_paths(args.paths, config.indexroot)

    if len(cleaned) == 0:
        return []

    # does not call gufi_common.gen_cmds
    return [gen_cmd(config, args, cleaned)]

# argv[0] should be the command name
def run(argv, config_path, stdout=None, stderr=None):
    config = gufi_config.Server(config_path)
    args = parse_args(argv)
    cmds = gen_cmds(config, args)
    return gufi_common.run_cmds(args, cmds,
                                1, 1, stdout, stderr)

if __name__ == '__main__':
    sys.exit(run(sys.argv, gufi_config.PATH)[0])
